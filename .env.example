# =============================================================================
# Nova Valet — environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# =============================================================================

# --- App -------------------------------------------------------------------
# Public base URL of the deployment (used for links, redirects, webhooks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Postgres connection string for the runtime data-access layer (the DAL runs
# SQL directly). Supabase → Project Settings → Database → Connection string
# (URI). Pooler URI recommended for the app runtime; URL-encode the password.
# When unset, the app falls back to a local in-process PGlite (dev only).
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# Project URL and anon (publishable) key are safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is SERVER-ONLY. Never expose to the client. Used by
# privileged server code in a later step.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Owner admin (B6) ------------------------------------------------------
# The single owner-operator's email. Only a Supabase-authenticated user whose
# email matches this may reach the admin; everyone else gets a 404. There is no
# self-signup — create the owner user in the Supabase dashboard.
OWNER_EMAIL=owner@example.com

# --- Payments (multi-provider) ---------------------------------------------
# Payments are multi-provider: Bancontact -> Mollie, card/Visa -> Stripe,
# routed by the method the customer picks. Both providers run on TEST keys now;
# going live is a per-provider key swap (set the live key for that provider),
# no code change and no redeploy required.

# Stripe (card / Visa). Mode is controlled purely by WHICH keys are set here.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret for verifying incoming Stripe webhook events.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mollie (Bancontact). Test key now; swap to the live key to go live.
MOLLIE_API_KEY=test_xxx

# --- Resend (email) --------------------------------------------------------
RESEND_API_KEY=re_xxx
# Verified sender address for transactional email.
RESEND_FROM_EMAIL=Nova Valet <bookings@example.com>

# --- WhatsApp --------------------------------------------------------------
# Owner's WhatsApp number in international format (digits only), used to build
# wa.me tap links in the manual adapter.
NEXT_PUBLIC_WHATSAPP_OWNER_NUMBER=32470000000
# Adapter selector: 'manual' (live now) or 'businessApi' (base layer, gated).
WHATSAPP_ADAPTER=manual
# --- WhatsApp Cloud API (config-gated, OFF until WABA approval + B7 wiring) --
# The businessApi adapter turns ON only when ACCESS_TOKEN + PHONE_NUMBER_ID are
# set AND WHATSAPP_ADAPTER=businessApi. send() is still not wired until B7 build.
# Meta ▸ WhatsApp ▸ API Setup: "Temporary access token" (24h) or a System-User
# permanent token (whatsapp_business_messaging + whatsapp_business_management).
WHATSAPP_ACCESS_TOKEN=
# Meta ▸ WhatsApp ▸ API Setup: "Phone number ID" (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Meta ▸ WhatsApp ▸ API Setup: "WhatsApp Business Account ID" (WABA id).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta ▸ App settings ▸ Basic ▸ "App secret" — used to verify webhook X-Hub
# signatures (parse, don't trust).
WHATSAPP_APP_SECRET=
# A random string YOU choose; paste the SAME value into Meta ▸ WhatsApp ▸
# Configuration ▸ Webhook "Verify token" when subscribing the callback URL.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Graph API version for the send/webhook calls. Default v22.0.
WHATSAPP_API_VERSION=v22.0
