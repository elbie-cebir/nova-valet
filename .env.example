# =============================================================================
# Nova Valet — environment variables
# Copy to `.env.local` and fill in. Never commit real secrets.
# =============================================================================

# --- App -------------------------------------------------------------------
# Public base URL of the deployment (used for links, redirects, webhooks).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
# Project URL and anon (publishable) key are safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key is SERVER-ONLY. Never expose to the client. Used by
# privileged server code in a later step.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments (multi-provider) ---------------------------------------------
# Payments are multi-provider: Bancontact -> Mollie, card/Visa -> Stripe,
# routed by the method the customer picks. Both providers run on TEST keys now;
# going live is a per-provider key swap (set the live key for that provider),
# no code change and no redeploy required.

# Stripe (card / Visa). Mode is controlled purely by WHICH keys are set here.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Signing secret for verifying incoming Stripe webhook events.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Mollie (Bancontact). Test key now; swap to the live key to go live.
MOLLIE_API_KEY=test_xxx

# --- Resend (email) --------------------------------------------------------
RESEND_API_KEY=re_xxx
# Verified sender address for transactional email.
RESEND_FROM_EMAIL=Nova Valet <bookings@example.com>

# --- WhatsApp --------------------------------------------------------------
# Owner's WhatsApp number in international format (digits only), used to build
# wa.me tap links in the manual adapter.
NEXT_PUBLIC_WHATSAPP_OWNER_NUMBER=32470000000
# Adapter selector: 'manual' (live now) or 'businessApi' (base layer, gated).
WHATSAPP_ADAPTER=manual
# --- WhatsApp Business API (config-gated, OFF until WABA approval) ----------
WHATSAPP_BUSINESS_API_TOKEN=
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
